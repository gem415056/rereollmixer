    }

    function init() {
        injectStyles();

        const ready = () => {
            if (!document.body) return;
            attachMixerButtons();

            attachTimer = setInterval(() => {
                attachMixerButtons();
            }, REFRESH_INTERVAL_MS);

            window.addEventListener('keydown', e => {
                if (e.key === 'Escape') closeModal();
            });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ready, { once: true });
        } else {
            ready();
        }
    }

    init();
})();
